package-as: LevelingCodex

enable-nolib-creation: no

# The release workflow writes RELEASE_NOTES.md (tools/release_notes.py) from the tag's
# section of CHANGELOG.md, so CurseForge shows only this version's notes. Markdown, not HTML:
# CurseForge's author console edits changelogs as Markdown and garbled the HTML ones.
manual-changelog:
  filename: RELEASE_NOTES.md
  markup-type: markdown

ignore:
  - README.md
  - CURSEFORGE_DESCRIPTION.md
  - RELEASE_NOTES.md
  - RELEASE_NOTES.html
  - RELEASING.md
  - CLAUDE.md
  - media/logo.png
  - media/logo.svg
  - AGENTS.md
  - tests
  - tools
  - docs
