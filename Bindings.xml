<Bindings>
  <!-- Esc > Options > Keybindings > AddOns: bind a key or controller button to open/close the Codex. -->
  <Binding name="LEVELINGCODEX_TOGGLE" header="LEVELINGCODEX" category="ADDONS">
    LevelingCodex_Toggle()
  </Binding>
  <!-- Uses the quest item shown beside the quest step window. -->
  <Binding name="CLICK LevelingCodexQuestItem:LeftButton" header="LEVELINGCODEX" category="ADDONS"/>
</Bindings>
